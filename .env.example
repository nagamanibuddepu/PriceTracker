# Database Configuration
MONGODB_URI=mongodb://localhost:27017/price-compare

# Scraping API Keys (Get these from their respective dashboards)
SCRAPINGBEE_API_KEY=your_scrapingbee_api_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
ZENROWS_API_KEY=your_zenrows_api_key_here
SERPAPI_KEY=your_serpapi_key_here
SCRAPERAPI_KEY=your_scraperapi_key_here

# AI Chat Integration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Configuration (BullMQ Jobs & Rate Limiting)
# Upstash: copy the "Redis URL" from the Upstash console — it MUST start with rediss:// (TLS)
# Example: rediss://default:YOUR_TOKEN@YOUR-DB.upstash.io:6379
REDIS_URL=rediss://default:your_redis_password@your_redis_host.upstash.io:6379

# Application Settings
DEMO_MODE=true
ADMIN_API_KEY=your_secure_admin_bypass_secret
